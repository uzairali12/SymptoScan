{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/public/html/index.html"
    },
    {
      "source": "/css/:path*",
      "destination": "/public/css/:path*"
    },
    {
      "source": "/js/:path*",
      "destination": "/public/js/:path*"
    },
    {
      "source": "/html/:path*",
      "destination": "/public/html/:path*"
    }
  ]
}